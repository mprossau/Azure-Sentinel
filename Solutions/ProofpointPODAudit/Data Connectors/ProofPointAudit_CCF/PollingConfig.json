[
	{
		"type": "Microsoft.SecurityInsights/dataConnectors",
		"apiVersion": "2025-09-01",
		"name": "ProofpointPODAuditConnection",
		"location": "{{location}}",
		"kind": "WebSocket",
		"properties": {
			"connectorDefinitionName": "ProofpointPODAuditCCFDefinition", 
			"dataType": "ProofpointPODAudit_CL",
			"auth": {
				"type": "APIKey",
				"ApiKey": "{{apiKey}}",
				"apiKeyName": "Authorization",
				"apiKeyIdentifier": "Bearer"
			},
			"request": {
				"httpMethod": "Get",
				"apiEndpoint": "wss://logstream.proofpoint.com:443/v1/stream",
				"queryParameters": {
					"cid": "{{clusterId}}",
					"type": "audit"
				},
				"rateLimitQPS": 20,
				"queryWindowInMin": 5,
				"retryCount": 2,
				"logResponseContent": true
			},
			"response": {
				"eventsJsonPaths": [
					"$"
				]
			},
			"dcrConfig": {
				"streamName": "Custom-ProofpointPODAuditLog",
				"dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
				"dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
			}
		}
	}
]