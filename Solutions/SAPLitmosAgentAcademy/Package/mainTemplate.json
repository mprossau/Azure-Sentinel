              "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
            },
            {
              "name": "SAPLitmosSettings_CL",
              "lastDataReceivedQuery": "SAPLitmosSettings_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
            },
            {
              "name": "SAPLitmosUserProfile_CL",
              "lastDataReceivedQuery": "SAPLitmosUserProfile_CL\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
