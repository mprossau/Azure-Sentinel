[
	{
		"type": "Microsoft.SecurityInsights/dataConnectors",
		"apiVersion": "2025-09-01",
		"name": "ZendeskAuditLogs",
		"location": "{{location}}",
		"kind": "RestApiPoller",
		"properties": {
			"connectorDefinitionName": "ZendeskAuditLogsCCFDefn",
			"dataType": "ZendeskAuditLogs_CL",
			"auth": {
				"type": "OAuth2",
				"GrantType": "client_credentials",
				"TokenEndpoint": "https://{{ZendeskSubdomain}}.zendesk.com/oauth/tokens",
				"ClientId": "{{ClientId}}",
				"ClientSecret": "{{ClientSecret}}",
				"Scope": "read",
				"TokenEndpointQueryParameters": {},
				"TokenEndpointHeaders": {
					"Accept": "application/json",
					"Content-Type": "application/x-www-form-urlencoded"
				}
			},
			"request": {
				"apiEndpoint": "https://{{ZendeskSubdomain}}.zendesk.com/api/v2/audit_logs",
				"httpMethod": "Get",
				"queryParameters": {
					"page[size]": "100"
				},
				"startTimeAttributeName": "filter[created_at][]",
				"endTimeAttributeName": "filter[created_at][]",
				"queryWindowInMin": 60,
				"queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
				"retryCount": 3,
				"timeoutInSeconds": 60,
				"headers": {
					"Accept": "application/json"
				}
			},
			"paging": {
				"pagingType": "NextPageToken",
				"pageSizeParameterName": "page[size]",
				"pageSize": 100,
				"nextPageParaName": "page[after]",
				"nextPageTokenJsonPath": "$.meta.after_cursor",
				"hasNextFlagJsonPath": "$..meta[?(@.has_more == true)]",
				"pagingInfoPlacement": "QueryString",
				"pagingQueryParamOnly": true
			},
			"response": {
				"format": "json",
				"eventsJsonPaths": [
					"$.audit_logs"
				]
			},
			"dcrConfig": {
				"streamName": "Custom-ZendeskAuditLogs",
				"dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
				"dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
			}
		}
	}
]