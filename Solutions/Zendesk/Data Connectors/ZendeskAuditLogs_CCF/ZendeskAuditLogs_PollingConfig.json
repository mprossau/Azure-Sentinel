[
	{
		"type": "Microsoft.SecurityInsights/dataConnectors",
		"apiVersion": "2025-09-01",
		"name": "ZendeskAuditLogs",
		"location": "{{location}}",
		"kind": "RestApiPoller",
		"properties": {
			"connectorDefinitionName": "ZendeskAuditLogsCCFDefn",
			"dataType": "ZendeskAuditLogs_CL",
			"auth": {
				"type": "OAuth2",
				"GrantType": "client_credentials",
				"TokenEndpoint": "https://{{ZendeskSubdomain}}.zendesk.com/oauth/token",
				"ClientId": "{{ZendeskClientId}}",
				"ClientSecret": "{{ZendeskClientSecret}}",
				"Scope": "read",
				"TokenEndpointHeaders": {
					"Content-Type": "application/json"
				},
				"IsClientSecretInHeader": false,
				"isCredentialsInHeader": false
			},
			"request": {
				"apiEndpoint": "https://{{ZendeskSubdomain}}.zendesk.com/api/v2/audit_logs",
				"httpMethod": "Get",
				"queryParameters": {
					"sort_by": "created_at",
					"sort_order": "asc",
					"page[size]": 100
				},
				"queryWindowInMin": 60,
				"startTimeAttributeName": "filter[created_at]",
				"endTimeAttributeName": "filter[created_at]",
				"queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
				"retryCount": 3,
				"timeoutInSeconds": 60,
				"headers": {
					"Accept": "application/json"
				}
			},
			"paging": {
				"pagingType": "NextPageUrl",
				"nextPageParaName": "links.next",
				"hasNextFlag": "meta.has_more"
			},
			"response": {
				"eventsJsonPaths": [
					"$.audit_logs"
				]
			}
			"dcrConfig": {
				"streamName": "Custom-ZendeskAuditLogs",
				"dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
				"dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}"
			}
		}
	}
]