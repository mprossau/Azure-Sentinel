                    },
                    {
                      "name": "OriginalUserId",
                      "type": "string"
                    },
                    {
                      "name": "Username",
                      "type": "string"
                    },
                    {
                      "name": "IPAddress",
                      "type": "string"
                    },
                    {
                      "name": "Environment",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "SAPLitmosSettings_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "schema": {
                  "name": "SAPLitmosSettings_CL",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime"
                    },
                    {
                      "name": "Environment",
                      "type": "string"
                    },
                    {
                      "name": "ActivityType",
                      "type": "string"
                    },
                    {
                      "name": "Category",
                      "type": "string"
                    },
                    {
                      "name": "ObjectType",
                      "type": "string"
                    },
                    {
                      "name": "ObjectId",
                      "type": "string"
                    },
                    {
                      "name": "OriginalObjectId",
                      "type": "int"
                    },
                    {
                      "name": "ObjectName",
                      "type": "string"
                    },
                    {
                      "name": "TargetObjectType",
                      "type": "string"
                    },
                    {
                      "name": "TargetObjectId",
                      "type": "string"
                    },
                    {
                      "name": "OriginalTargetObjectId",
                      "type": "int"
                    },
                    {
                      "name": "TargetObjectName",
                      "type": "string"
                    },
                    {
                      "name": "OldValue",
                      "type": "string"
                    },
                    {
                      "name": "NewValue",
                      "type": "string"
                    },
                    {
                      "name": "ActivityBy",
                      "type": "int"
                    },
                    {
                      "name": "ActivityByUserName",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "SAPLitmosUserProfile_CL",
              "apiVersion": "2022-10-01",
              "type": "Microsoft.OperationalInsights/workspaces/tables",
              "location": "[parameters('workspace-location')]",
              "kind": null,
              "properties": {
                "schema": {
                  "name": "SAPLitmosUserProfile_CL",
                  "columns": [
                    {
                      "name": "TimeGenerated",
                      "type": "datetime"
                    },
                    {
                      "name": "Environment",
                      "type": "string"
                    },
                    {
                      "name": "ActivityType",
                      "type": "string"
                    },
                    {
                      "name": "UserId",
                      "type": "string"
                    },
                    {
                      "name": "OriginalUserId",
                      "type": "int"
                    },
                    {
                      "name": "OldValue",
                      "type": "string"
                    },
                    {
                      "name": "NewValue",
                      "type": "string"
                    },
                    {
                      "name": "CustomFieldLabel",
                      "type": "string"
                    },
                    {
                      "name": "ActivityBy",
                      "type": "int"
                    },
                    {
                      "name": "ActivityByUserName",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
        "packageKind": "Solution",
        "packageVersion": "[variables('_solutionVersion')]",
        "packageName": "[variables('_solutionName')]",
        "contentProductId": "[concat(take(variables('_solutionId'), 50),'-','dc','-', uniqueString(concat(variables('_solutionId'),'-','DataConnector','-',variables('_dataConnectorContentIdConnectorDefinition1'),'-', variables('dataConnectorCCPVersion'))))]",
        "packageId": "[variables('_solutionId')]",
        "contentSchemaVersion": "3.0.0",
        "version": "[variables('dataConnectorCCPVersion')]"
      }
    },
    {
      "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/',variables('_dataConnectorContentIdConnectorDefinition1'))]",
      "apiVersion": "2022-09-01-preview",
      "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectorDefinitions",
      "location": "[parameters('workspace-location')]",
      "kind": "Customizable",
      "properties": {
        "connectorUiConfig": {
          "id": "SAPLitmosAgentAcademyCCFDefn",
          "title": "SAP Litmos Org Activity Logs (via CCF) - Agency Academy",
          "publisher": "Scenic Security",
          "descriptionMarkdown": "Ingests SAP Litmos org activity logs into Microsoft Sentinel via the Codeless Connector Framework. To connect multiple SAP Litmos environments, deploy this connector once per source identifier.",
          "graphQueriesTableName": "SAPLitmosLogin_CL",
          "graphQueries": [
