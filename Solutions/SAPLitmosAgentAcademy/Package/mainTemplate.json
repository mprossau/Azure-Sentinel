              "query": "SAPLitmosSettings_CL\n| sort by TimeGenerated desc\n| take 10"
            },
            {
              "description": "Show the latest SAP Litmos user profile change events",
              "query": "SAPLitmosUserProfile_CL\n| sort by TimeGenerated desc\n| take 10"
            }
          ],
          "dataTypes": [
